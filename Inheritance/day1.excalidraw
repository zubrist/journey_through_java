    {
      "id": "ctQ_Bn1JTgGXabRzVhZGh",
      "type": "text",
      "x": 225.79998779296875,
      "y": 280,
      "width": 892.8192749023438,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
