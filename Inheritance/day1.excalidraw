      "seed": 1639656396,
      "version": 97,
      "versionNonce": 1086726388,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783248567614,
      "link": null,
      "locked": false,
      "text": "Inheritance in Java is a mechanism that allows one class (called the subclass or child class)\nto acquire the properties and behaviors (fields and methods) of another class \n(called the superclass or parent class). ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inheritance in Java is a mechanism that allows one class (called the subclass or child class)\nto acquire the properties and behaviors (fields and methods) of another class \n(called the superclass or parent class). ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WEoNdB16pAWpiRiM8fvm0",
      "type": "text",
      "x": 256,
      "y": 453,
      "width": 842.3993530273438,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a3",
      "roundness": null,
      "seed": 717851724,
      "version": 173,
      "versionNonce": 1611532876,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1783248791734,
      "link": null,
      "locked": false,
      "text": "Overloading : samename func() different arguments i.e add(int , int ) add(float, float )\nOverriding : same name but different body ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Overloading : samename func() different arguments i.e add(int , int ) add(float, float )\nOverriding : same name but different body ",
      "autoResize": true,
      "lineHeight": 1.25
    },
