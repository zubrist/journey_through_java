      "updated": 1783249246096,
      "link": null,
      "locked": false,
      "text": "class ParentClass {\n    // fields and methods\n}\n\nclass ChildClass extends ParentClass {\n    // additional fields and methods\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class ParentClass {\n    // fields and methods\n}\n\nclass ChildClass extends ParentClass {\n    // additional fields and methods\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
