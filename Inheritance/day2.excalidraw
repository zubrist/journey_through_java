      "updated": 1783781460909,
      "link": null,
      "locked": false,
      "text": "Dynamic Method Dispatch is a mechanism where a call to an\noverridden method is resolved at runtime rather than compile-\ntime.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Dynamic Method Dispatch is a mechanism where a call to an overridden method is resolved at runtime rather than compile-time.",
      "autoResize": false,
      "lineHeight": 1.25
    },
