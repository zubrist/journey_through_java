      "type": "text",
      "x": 779.8802490234375,
      "y": 3428.199981689453,
      "width": 383.23968505859375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 2093208066,
      "version": 147,
      "versionNonce": 1763672222,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740469844,
      "link": null,
      "locked": false,
      "text": "After each iteration, minimum is placed\nin the front of the unsorted list",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "After each iteration, minimum is placed in the front of the unsorted list",
      "autoResize": false,
      "lineHeight": 1.25
    },
