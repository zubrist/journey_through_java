    {
      "id": "slhHx2QXS7IKAuj_oUGG5",
      "type": "text",
      "x": 782.2803955078125,
      "y": 3068.5,
      "width": 358.8394775390625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 811461826,
      "version": 138,
      "versionNonce": 1279040222,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740262541,
      "link": null,
      "locked": false,
      "text": "Compare minimum with the second\nelement. If the second element is\nsmaller than minimum, assign the\nsecond element as minimum",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Compare minimum with the second element. If the second element is smaller than minimum, assign the second element as minimum",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "FfuXBQQXfTn5RgyunlvPp",
      "type": "text",
      "x": 780.8703308105469,
      "y": 3189,
      "width": 354.0596313476562,
      "height": 150,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 1511551362,
      "version": 150,
      "versionNonce": 1317962754,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740412574,
      "link": null,
      "locked": false,
      "text": "Compare minimum with the third\nelement. Again, if the third element\nis smaller, then assign minimum to\nthe third element otherwise do\nnothing. The process goes on until\nthe last element.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Compare minimum with the third element. Again, if the third element is smaller, then assign minimum to the third element otherwise do nothing. The process goes on until the last element.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "EXNXYmKVIv-xzGklBx9L5",
      "type": "image",
      "x": 408.3000183105469,
      "y": 3407.4000549316406,
      "width": 357,
      "height": 102,
      "angle": 0,
      "strokeColor": "transparent",
