    },
    {
      "id": "yluSFl81S4i6Z6RwSZhMg",
      "type": "text",
      "x": 369.0602111816406,
      "y": 2101.5999755859375,
      "width": 706.8795776367188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 929816158,
      "version": 135,
      "versionNonce": 1925437890,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789739097968,
      "link": null,
      "locked": false,
      "text": "1-> Start with the first element (index 0) and compare it with the next\nelement (index 1).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1-> Start with the first element (index 0) and compare it with the next element (index 1).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "9E8c4X1oYMDyJkhHFegzZ",
      "type": "text",
      "x": 371.9703063964844,
      "y": 2164.000015258789,
      "width": 686.6595458984375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 747519618,
      "version": 127,
      "versionNonce": 96360706,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789739101048,
      "link": null,
      "locked": false,
      "text": "2-> If the first element is greater than the second element, swap\nthem.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2-> If the first element is greater than the second element, swap them.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "QIS6YfzyBZbpnYMqjjlRr",
      "type": "text",
      "x": 372.3802490234375,
      "y": 2224.7999877929688,
      "width": 722.6397094726562,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1499226782,
      "version": 142,
      "versionNonce": 2035949634,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789739104078,
      "link": null,
      "locked": false,
      "text": "3-> Move to the next pair of elements (index 1 and index 2) and compare\nthem. Again, swap if necessary.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3-> Move to the next pair of elements (index 1 and index 2) and compare them. Again, swap if necessary.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "32ZV01bMPx_8zefDrFprs",
      "type": "text",
      "x": 366.6602783203125,
      "y": 2285.4999389648438,
      "width": 607.1996459960938,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1124539970,
      "version": 97,
      "versionNonce": 1280241474,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789739110239,
      "link": null,
      "locked": false,
      "text": "4 -> Continue this process until you reach the end of the list.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4 -> Continue this process until you reach the end of the list.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "gpCnEeeI5K_K-eg-gEhYo",
      "type": "text",
      "x": 366.2502136230469,
      "y": 2327.7999877929688,
      "width": 706.0996093749999,
      "height": 25,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 724721374,
      "version": 106,
      "versionNonce": 440270658,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789739089565,
      "link": null,
      "locked": false,
      "text": "# After the first pass, the largest element will be at the last position.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "# After the first pass, the largest element will be at the last position.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "WDRF-HW5QPSSRUyS7WXcG",
      "type": "text",
      "x": 369.75030517578125,
      "y": 2367.3999938964844,
      "width": 749.4995727539062,
      "height": 50,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 516818434,
      "version": 168,
      "versionNonce": 1364856734,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789739124261,
      "link": null,
      "locked": false,
      "text": "5-> Repeat steps 1-5 for the remaining elements (excluding the last sorted\nelement) until the entire list is sorted.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5-> Repeat steps 1-5 for the remaining elements (excluding the last sorted element) until the entire list is sorted.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "iRT7k6aDRUQUcqIJUH7AH",
      "type": "text",
      "x": 344.3900909423828,
