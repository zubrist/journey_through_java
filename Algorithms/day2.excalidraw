      "link": null,
      "locked": false,
      "text": "Algorithm:",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algorithm:",
      "autoResize": true,
