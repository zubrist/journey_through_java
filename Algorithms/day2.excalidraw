    {
      "id": "Y-F_5NhLMACBrcGKV1K30",
      "type": "text",
      "x": 369.8101272583008,
      "y": 5038.300003051758,
      "width": 133.04728925536384,
      "height": 34.8000030517578,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 1905051970,
      "version": 49,
      "versionNonce": 374914626,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789741659113,
      "link": null,
      "locked": false,
      "text": "Algorithm:",
      "fontSize": 27.840002441406245,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Algorithm:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "-vEpGbq3pVodOelb9mDQw",
      "type": "text",
      "x": 373.4702453613281,
      "y": 5109.600006103516,
      "width": 636.0595703125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aU",
      "roundness": null,
      "seed": 1366352862,
      "version": 84,
      "versionNonce": 1329034498,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740797365,
      "link": null,
      "locked": false,
      "text": "1-> We start by iterating through the array from index 0 to n-1,\nwhere n is the length of the array.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1-> We start by iterating through the array from index 0 to n-1, where n is the length of the array.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "axP3byWFmfgB7S5P8505h",
      "type": "text",
      "x": 371.0902099609375,
      "y": 5179.800018310547,
      "width": 613.4196166992188,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 1701204226,
      "version": 59,
      "versionNonce": 1637317570,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740819642,
      "link": null,
      "locked": false,
      "text": "2-> For each iteration, we assume that the element at the\ncurrent index is the smallest (min_index = i).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2-> For each iteration, we assume that the element at the current index is the smallest (min_index = i).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "-irTvxCsNhmzklqKMld_B",
      "type": "text",
      "x": 374.8401794433594,
      "y": 5244,
      "width": 631.7196655273438,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 1201977374,
      "version": 95,
      "versionNonce": 2023278686,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740829397,
      "link": null,
      "locked": false,
      "text": "3-> We then iterate through the rest of the array starting\nfrom i+1.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3-> We then iterate through the rest of the array starting from i+1.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "enhGM2YDtXJUYEkOVnJOc",
      "type": "text",
      "x": 372.81024169921875,
      "y": 5301.100036621094,
      "width": 615.9795532226562,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 2084102338,
      "version": 121,
      "versionNonce": 1489665246,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740867737,
      "link": null,
      "locked": false,
      "text": "4-> If we find an element smaller than the current smallest\nelement (A[min_index]), we update min_index to the index of\nthe new smallest element.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4-> If we find an element smaller than the current smallest element (A[min_index]), we update min_index to the index of the new smallest element.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "8j72iW5eBohyaQ9Q-02T2",
      "type": "text",
      "x": 370.4001770019531,
      "y": 5398.600036621094,
      "width": 615.9996337890625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 684983390,
      "version": 106,
      "versionNonce": 1300284098,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740875703,
      "link": null,
      "locked": false,
      "text": "5-> After completing the inner loop, we swap the element at\nindex i with the smallest element found (A[min_index]).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "5-> After completing the inner loop, we swap the element at index i with the smallest element found (A[min_index]).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "pWhQHuFEoU72qroGMXmto",
      "type": "text",
      "x": 367.8901672363281,
      "y": 5471.700012207031,
      "width": 522.2196044921875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 27490434,
      "version": 71,
      "versionNonce": 967275486,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740890938,
      "link": null,
      "locked": false,
      "text": "This process repeats until the entire array is sorted.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This process repeats until the entire array is sorted.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "K80i5jZwD5BJqWHIssxwH",
      "type": "text",
      "x": 357.7201156616211,
      "y": 5569.300048828125,
      "width": 246.9597930908203,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 365975710,
      "version": 130,
      "versionNonce": 704220098,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740914868,
      "link": null,
      "locked": false,
      "text": "selectionSort(array, size)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "selectionSort(array, size)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "e2BOiug9H-7jB5kg-H3nV",
      "type": "text",
      "x": 416.39007568359375,
      "y": 5617.900085449219,
      "width": 257.619873046875,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ab",
      "roundness": null,
      "seed": 813008962,
      "version": 90,
      "versionNonce": 439710,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740918340,
      "link": null,
      "locked": false,
      "text": "for i from 0 to size - 1 do",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for i from 0 to size - 1 do",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "nPpYo1a1nws8qjWGTzOz-",
      "type": "text",
      "x": 442.0700988769531,
      "y": 5648.299987792969,
      "width": 402.65972900390625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 1639421150,
      "version": 128,
      "versionNonce": 513280386,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740924974,
      "link": null,
      "locked": false,
      "text": "set i as the index of the current minimum",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "set i as the index of the current minimum",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "7Y8pPh4LsMWUQYT4Fg6xL",
      "type": "text",
      "x": 441.18011474609375,
      "y": 5680.700134277344,
      "width": 286.4398193359375,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 1725902850,
      "version": 100,
      "versionNonce": 2003796510,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740928201,
      "link": null,
      "locked": false,
      "text": "for j from i + 1 to size - 1 do",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "for j from i + 1 to size - 1 do",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "X7RzxxjjcRa7nQZGh4G1_",
      "type": "text",
      "x": 474.0801544189453,
      "y": 5718.900085449219,
      "width": 342.2397155761719,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ae",
      "roundness": null,
      "seed": 1575831838,
      "version": 104,
      "versionNonce": 718462366,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789740931493,
      "link": null,
      "locked": false,
      "text": "if array[j] < array[current minimum]",
