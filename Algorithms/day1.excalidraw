      "updated": 1787823176459,
      "link": null,
      "locked": false,
      "text": "A problem (often referred to as a computational problem) is a\nquestion, task, or objective that can be addressed, analyzed, and\nsolved using a computer program or an algorithm.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A problem (often referred to as a computational problem) is a question, task, or objective that can be addressed, analyzed, and solved using a computer program or an algorithm.",
      "autoResize": false,
      "lineHeight": 1.25
    },
