    {
      "id": "OXeM4izALxn06lToYWTNp",
      "type": "text",
      "x": 601.3741042603026,
      "y": 5231.993164850745,
      "width": 413.21978759765625,
      "height": 275,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
