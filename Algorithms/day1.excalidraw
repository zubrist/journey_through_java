      "seed": 1724213856,
      "version": 45,
      "versionNonce": 2069047904,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787826858380,
      "link": null,
      "locked": false,
      "text": "INPUT Array, target\n\nFOR i FROM 0 TO length(array) - 1 DO\n    IF array[i] == target THEN\n        PRINT \"Element found at index: \", i\n        RETURN i\n    ENDIF\nENDFOR\n\nPRINT \"Element not found in the list\"\nRETURN -1",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "INPUT Array, target\n\nFOR i FROM 0 TO length(array) - 1 DO\n    IF array[i] == target THEN\n        PRINT \"Element found at index: \", i\n        RETURN i\n    ENDIF\nENDFOR\n\nPRINT \"Element not found in the list\"\nRETURN -1",
      "autoResize": true,
      "lineHeight": 1.25
    },
