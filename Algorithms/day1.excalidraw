      "boundElements": null,
      "updated": 1787827834828,
      "link": null,
      "locked": false,
      "text": "-> If the element at mid equals the target, stop and return the index mid",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> If the element at mid equals the target, stop and return the index mid",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "shdlXHDqr4cEnG4xNxqTa",
      "type": "text",
      "x": 655.9762152546007,
      "y": 6205.703038824765,
      "width": 705.4999692501674,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1P",
      "roundness": null,
      "seed": 359906208,
      "version": 114,
      "versionNonce": 1784335968,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787827866014,
      "link": null,
      "locked": false,
      "text": "-> If the target is greater than the element at mid, the target must\nbe in the right half; update low = mid + 1",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> If the target is greater than the element at mid, the target must be in the right half; update low = mid + 1",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "5BMrRDMFDDW0DowRxhzeQ",
      "type": "text",
      "x": 655.3669759023186,
      "y": 6274.81177134504,
      "width": 705.4999692501674,
      "height": 50,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1Q",
      "roundness": null,
      "seed": 718731168,
      "version": 137,
      "versionNonce": 1093536,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787827911095,
      "link": null,
      "locked": false,
      "text": "-> If  the target is less than the element at mid, the target must be in\nthe left half; update high = mid - 1",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "-> If  the target is less than the element at mid, the target must be in the left half; update high = mid - 1",
      "autoResize": false,
      "lineHeight": 1.25
    }
