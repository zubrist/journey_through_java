    },
    {
      "id": "M_DYMcrDLKKGAe_J9FNbY",
      "type": "text",
      "x": 273.33919787188626,
      "y": 1493.072127441552,
      "width": 779.7435302734375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 1,
