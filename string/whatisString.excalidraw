      "boundElements": null,
      "updated": 1790261406664,
      "link": null,
      "locked": false,
      "text": "Each time you create a string literal, the JVM checks the string pool first.\nIf the string already exists in the pool, a reference to the pooled\ninstance is returned. \nIf the string doesn’t exist in the pool, a new string instance is created\nand placed in the pool.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Each time you create a string literal, the JVM checks the string pool first. If the string already exists in the pool, a reference to the pooled instance is returned. \nIf the string doesn’t exist in the pool, a new string instance is created and placed in the pool.",
      "autoResize": false,
      "lineHeight": 1.25
    },
