      "isDeleted": false,
      "boundElements": null,
      "updated": 1790261877093,
      "link": null,
      "locked": false,
      "text": "When we use the “new” keyword, a new instance of the string is created in the\nheap, regardless of whether it already exists in the string pool.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "When we use the “new” keyword, a new instance of the string is created in the heap, regardless of whether it already exists in the string pool.",
      "autoResize": false,
      "lineHeight": 1.25
    },
