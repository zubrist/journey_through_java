    {
      "id": "F85JFEwNDxaAR95UUovKm",
      "type": "text",
      "x": 153.47141817088274,
      "y": 1875.129720979885,
      "width": 889.3394165039062,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 1008029767,
      "version": 86,
      "versionNonce": 628514279,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779196239170,
      "link": null,
      "locked": false,
      "text": "If the sum of the digits of a number is equal to the product of its digits, then it's called \na Spy Number. Java program to check if the given number is SPy number or not ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "If the sum of the digits of a number is equal to the product of its digits, then it's called \na Spy Number. Java program to check if the given number is SPy number or not ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "2ZByXc8gC0NvJ51S3AloQ",
      "type": "text",
      "x": 148.8331831120873,
      "y": 2022.3936840966412,
      "width": 873.3394165039062,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 248130601,
      "version": 4,
      "versionNonce": 1080071815,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779196305942,
      "link": null,
      "locked": false,
      "text": "A Fascinating Number in Java is a number that, when you concatenate the original number,\n its double, and its triple, and the result has all digits from 1 to 9 exactly once.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A Fascinating Number in Java is a number that, when you concatenate the original number,\n its double, and its triple, and the result has all digits from 1 to 9 exactly once.",
      "autoResize": true,
      "lineHeight": 1.25
    },
