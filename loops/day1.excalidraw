      "seed": 20603687,
      "version": 112,
      "versionNonce": 1231995655,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1779196032100,
      "link": null,
      "locked": false,
      "text": "An Armstrong number is a number that is equal to the sum of its digits, where\neach digit is raised to the power of the total number of digits in the number.\nFor example, 153 is an Armstrong number because 1³ + 5³ + 3³ = 153.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An Armstrong number is a number that is equal to the sum of its digits, where each digit is raised to the power of the total number of digits in the number. For example, 153 is an Armstrong number because 1³ + 5³ + 3³ = 153.",
      "autoResize": false,
      "lineHeight": 1.25
    },
