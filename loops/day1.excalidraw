    {
      "id": "e0QSan0QnJGOgQhgdh0dt",
      "type": "text",
      "x": 152.27888866174303,
      "y": 1592.49905828032,
      "width": 763.51953125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
