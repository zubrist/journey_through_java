    {
      "id": "PdnaLOGKfFakaR42f7ggY",
      "type": "text",
      "x": 262.5500946044922,
      "y": 524.0498962402344,
      "width": 950.6308194024026,
      "height": 87.0000457763672,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
