      "seed": 579982745,
      "version": 139,
      "versionNonce": 1414895031,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784976239397,
      "link": null,
      "locked": false,
      "text": "The Exception class represents conditions that a program might want to catch.\nThese are events that are usually recoverable and can be handled in the program\nusing try-catch blocks.",
      "fontSize": 23.200012207031254,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The Exception class represents conditions that a program might want to catch. These are events that are usually recoverable and can be handled in the program using try-catch blocks.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "DW9NFe7n_b_BCF3Eo1WJC",
      "type": "text",
      "x": 360.88050079345703,
      "y": 648.0500640869141,
      "width": 778.3394165039062,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 904843097,
      "version": 60,
      "versionNonce": 628253561,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784976503965,
      "link": null,
      "locked": false,
      "text": "Checked Exceptions: Checked at compile-time (e.g., IOException, SQLException)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Checked Exceptions: Checked at compile-time (e.g., IOException, SQLException)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "k7Kk44eCGZizk1PRj4CQL",
      "type": "text",
      "x": 362.1805191040039,
      "y": 686.5500106811523,
      "width": 909.489532470703,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 11218615,
      "version": 173,
      "versionNonce": 2120108631,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784976621135,
      "link": null,
      "locked": false,
      "text": "Unchecked Exceptions: Checked at runtime (e.g., NullPointerException, ArithmeticException)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Unchecked Exceptions: Checked at runtime (e.g., NullPointerException, ArithmeticException)",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "NYCGJJbhZqf0Z6eH_Y6-A",
      "type": "text",
      "x": 264.2103042602539,
      "y": 755.5499877929688,
      "width": 954.9295501708982,
      "height": 75,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 532669753,
      "version": 77,
      "versionNonce": 838385241,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1784976647504,
      "link": null,
      "locked": false,
      "text": "Errors are serious issues that a program should not try to catch. They indicate problems that\nare beyond the control of the application, often related to the system or the Java Virtual\nMachine (JVM) itself.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Errors are serious issues that a program should not try to catch. They indicate problems that are beyond the control of the application, often related to the system or the Java Virtual Machine (JVM) itself.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
