      "isDeleted": false,
      "boundElements": null,
      "updated": 1780828924537,
      "link": null,
      "locked": false,
      "text": "Achieved using access modifiers like private, protected, and public.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
